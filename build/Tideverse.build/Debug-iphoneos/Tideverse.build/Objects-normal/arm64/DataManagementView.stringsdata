      },
      {
        "comment": "",
        "key": "Turn this off for a smaller text-only archive. Photos will stay on this device but will not be included in that backup. Archives must be 35 MB or smaller to restore.",
        "location": {
          "startingColumn": 22,
          "startingLine": 34
        }
      },
      {
        "comment": "",
        "key": "JSON archives can contain private messages, attached photos and memory notes. Save them only to a location you trust. Import merges new records and restores newer progress.",
